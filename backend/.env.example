# Copy to .env only if it does not exist. Keys stay on the server.
# Gemini is the active provider; set zhipu only to opt into its separate configuration.
VISION_PROVIDER=gemini
# To select DeepSeek, set VISION_PROVIDER=deepseek after adding its own key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4.6v-flash
VISION_API_KEY=
# Active Gemini configuration.
GEMINI_API_KEY=
# An image-capable model available to your account, supporting JSON output.
GEMINI_MODEL=
HOST=0.0.0.0
PORT=8787
REQUEST_TIMEOUT_MS=60000
